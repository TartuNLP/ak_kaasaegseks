# lihtsad täheteisendused vanast tavast tänasesse
define uustäht   [w (->) v::10] .o. 
                 [W (->) V::10] .o.
                 [w (->) f::100] .o. 
                 [W (->) F::100] .o.
                 [i (->) ü::300] .o.
                 [ü (->) i::300] .o.
                 [i (->) j::100] .o.
                 [{öi} (->) {eu}::100] .o.
                 [{hw} (->) f::100] .o. 
                 [{bt} (->) b::100] .o. 
                 [s (->) {ss}::10 || [l|m|n|r] _ ] .o. 
                 [{ns} (->) {nts}::100] .o.
                 [h (->) {hh}::100] .o. 
                 [{sh} (->) š::10] .o.
                 [{Sh} (->) Š::10] .o.
                 [{sh} (->) ž::10] .o.
                 [{sh} (->) s::10] .o.
                 [{Sh} (->) S::10]
                 ;

define eemaldakriips [{-} (->) ""::30] ;
                                 
define sisestusvead [eestitäish .o. 
                    [{rn} (->) m::100] .o.
#                    [{nr} (->) m::100] .o.
                    [{ni} (->) m::100] .o.
                    [{in} (->) m::100] .o.
                    [{rm} (->) {nn}::100] .o.
                    [{li} (->) h::300] .o.
#                    [ü (->) {ii}::300] .o.
                    [i (->) l::300] .o.
                    [I (->) l::300] .o.
                    [l (->) i::300] .o.
                    [f (->) i::300] .o.
                    [l (->) t::300] .o.
                    [i (->) t::300] .o.
                    [c (->) e::300] .o.
                    [s (->) e::300] .o.
                    [n (->) p::300] .o.
                    [p (->) u::300] .o.
#                    kolmkaheks .o. 
                    muudatapid .o.
                    eemaldakriips] 
                    ;
                 
define ortograafia [uustäht .o.
                   kaksyheks]
                   ;
#define teisenda [tuletus .o. ortograafia .o. sisestusvead .o. sona] ;
define teisenda [sisestusvead .o. ortograafia .o. tuletus .o. sona] ;

regex teisenda ;

