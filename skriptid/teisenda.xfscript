# hfst-xfst skript
# kompileerimiseks e. muunduri teisenda.hfst tegemiseks tee nii:
# echo 'save stack teisenda.hfst' | hfst-xfst -l teisenda.xfscript
# kasutamine: echo 'asutaw' | hfst-lookup teisenda.hfst
# tulemus:    asutav
# 

# ainult sellised, mis võivad topelttähena esineda
define kolmkaheks  [{aaa} (->) {aa}::100] .o.
                   [{eee} (->) {ee}::100] .o.
                   [{fff} (->) {ff}::100] .o.
                   [{hhh} (->) {hh}::100] .o.
                   [{iii} (->) {ii}::100] .o.
                   [{kkk} (->) {kk}::100] .o.
                   [{lll} (->) {ll}::100] .o.
                   [{mmm} (->) {mm}::100] .o.
                   [{nnn} (->) {nn}::100] .o.
                   [{ooo} (->) {oo}::100] .o.
                   [{ppp} (->) {pp}::100] .o.
                   [{rrr} (->) {rr}::100] .o.
                   [{sss} (->) {ss}::100] .o.
                   [{ttt} (->) {tt}::100] .o.
                   [{uuu} (->) {uu}::100] .o.
                   [{vvv} (->) {vv}::100] .o.
                   [{õõõ} (->) {õõ}::100] .o.
                   [{äää} (->) {ää}::100] .o.
                   [{ööö} (->) {öö}::100] .o.
                   [{üüü} (->) {üü}::100] 
                    ;

# ainult sellised, mis võivad topelttähena esineda
define kaksyheks   [{aa} (->) {a}::200] .o.
                   [{ee} (->) {e}::200] .o.
                   [{ff} (->) {f}::200] .o.
                   [{hh} (->) {h}::200] .o.
                   [{ii} (->) {i}::200] .o.
                   [{kk} (->) {k}::200] .o.
                   [{ll} (->) {l}::200] .o.
                   [{mm} (->) {m}::200] .o.
                   [{nn} (->) {n}::200] .o.
                   [{oo} (->) {o}::200] .o.
                   [{pp} (->) {p}::200] .o.
                   [{rr} (->) {r}::200] .o.
                   [{ss} (->) {s}::200] .o.
                   [{tt} (->) {t}::200] .o.
                   [{uu} (->) {u}::200] .o.
                   [{vv} (->) {v}::200] .o.
                   [{õõ} (->) {õ}::200] .o.
                   [{ää} (->) {ä}::200] .o.
                   [{öö} (->) {ö}::200] .o.
                   [{üü} (->) {ü}::200] 
                    ;

                    
# täpitähed võivad igapidi segi olla; kas panna suurem kaal??
# ei luba teisendada sõnu:
# kõlb -> kolb , kahe -> kähe
define tapid [ä (->) a::300] .o.
             [ö (->) o::300] .o.
             [õ (->) o::300 || \k _ , _ \l \b] .o.
             [ü (->) u::300] .o.
             [ö (->) õ::300] .o.
             [õ (->) ö::300] .o.
             [a (->) ä::300 || \k _ , _ \h \e] .o.
             [o (->) õ::300] .o.
             [o (->) ö::300] .o.
             [u (->) ü::300] 
              ;

# korras sõna(osa)d, mida ei tohiks teisendada, sest teisendades võib tekkida üks teine kah eestikeelne sõna
#define jubakorras $[{väärt} | {wäärt} | {kahe} | {kõlb}] ;

define muudatapid tapid;

# eesti tähe asemel on mõnikord hoopis...
define eestitäish  [ï (->) i::10] .o.
                [À (->) A::10] .o.
                [à (->) a::10] .o.
                [é (->) e::10] .o.
                [ë (->) e::10] .o.
                [î (->) i::10] .o.
                [ë (->) ä::10] .o.
                [ô (->) õ::10] .o.
                [ç (->) e::10] .o.
                [è (->) e::10] 
                ;  

# regulaarsed muutused tuletusliidetes
# sündmata ei käändu, aga sündmatu peaks; kui asendaks, tekiks ebagramm. lause
define tuletus [a  (->) e::50  || [k|p|t|l|m|n|r|s][k|p|t|s] _ .#.] .o.
               [{ismus}   (->) "ism"::50 || ? ? ? ? _ .#.] .o.
               [{ikus}   (->) "ik"::50 || ? ? ? ? _ .#.] .o.
               [{ikuse}   (->) {iku}::50 || ? ? ? ? _ .#.] .o.
               [{ismuse}   (->) {ismi}::50 || ? ? ? ? _ .#.] .o.
               [{ismust}   (->) {ismi}::50 || ? ? ? ? _ .#.] .o.
               [{iumisid}   (->) {iume}::10] .o.
               [{konde}   (->) {kondi}::10 || _ .#.] .o.
               [{kui}   (->) {ke}::50    || _ [l|s|k]] .o.
               [{line}  (->) {lik}::50   || ? ? ? ? _ .#.] .o.
               [{lise}  (->) {liku}::50  || ? ? ? ? _ ] .o.
               [{list}  (->) {likku}::50 || ? ? ? ? _ .#.] .o.
               [{liste} (->) {like}::50  || ? ? ? ? _ ] .o.
               [{lisi}  (->) {likke}::50 || ? ? ? ? _ .#.] .o.
               [(i) {line}  (->) {ne}::60   || ? ? ? ? _ .#.] .o.
               [(i) {lise}  (->) {se}::60  || ? ? ? ? _ ] .o.
               [(i) {lisse}  (->) {sesse}::60  || ? ? ? ? _ ] .o.
               [(i) {list}  (->) {set}::60 || ? ? ? ? _ .#.] .o.
               [(i) {liste} (->) {sete}::60  || ? ? ? ? _ ] .o.
               [(i) {lisi}  (->) {seid}::60 || ? ? ? ? _ .#.] .o.
               [{lik}  (->) {line}::50   || ? ? ? ? _ .#.] .o.
               [{liku}  (->) {lise}::50  || ? ? ? ? _ ] .o.
               [{likku}  (->) {list}::50 || ? ? ? ? _ .#.] .o.
               [{like} (->) {liste}::50  || ? ? ? ? _ ] .o.
               [{likke}  (->) {lisi}::50 || ? ? ? ? _ .#.] .o.
               [{ikude}  (->) {ikkude}::50   || ? ? ? ? _ ] .o.
               [{ikkude}  (->) {ike}::50   || ? ? ? ? _ ] .o.
               [{lik}  (->) {ne}::60   || ? ? ? ? _ .#.] .o.
               [{liku}  (->) {se}::60  || ? ? ? ? _ ] .o.
               [{likku}  (->) {set}::60 || ? ? ? ? _ .#.] .o.
               [{likkude}  (->) {sete}::60 || ? ? ? ? _ ] .o.
               [{like} (->) {sete}::60  || ? ? ? ? _ ] .o.
               [{likke}  (->) {seid}::60 || ? ? ? ? _ .#.] .o.
               [{likka}  (->) {seid}::60 || ? ? ? ? _ .#.] .o.
               [{ikude}  (->) {sete}::60   || ? ? ? ? _ ] .o.
               [{likuid}  (->) {likke}::50 || ? ? ? ? _ .#.] .o.
               [{akse}  (->) {atakse}::50 || ? ? ? ? _ .#.] .o.  # parand+akse --> parand+atakse
               [{mata}  (->) {matu}::50 || _ ({ks}|{le}|{l}|{lt}|{d}) .#. , \s \ü \n \d _ ] .o.
               [o (l) {leeri}  (->) {olli}::50 || ? ? _ ] .o.   # kontroll*eeri, protokoll*eeri
               [ü {seeri}  (->) ü ü {si}::50 || ? ? _ ] .o.   # analüseeri -> analüüsi
               [{nem}  (->) {m}::50 || ? ? _ ]
               ;

